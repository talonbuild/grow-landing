# Copy to .env.local for local overrides, or set these in Vercel → Project → Settings → Environment Variables.
# All are optional; src/config/site.ts is the primary configuration.

# Production origin for canonical + Open Graph URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Kit public form ID (the number in https://app.kit.com/forms/<id>/subscriptions). Not a secret.
NEXT_PUBLIC_KIT_FORM_ID=

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to load no analytics script.
NEXT_PUBLIC_GA4_ID=
